{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "needs_information",
        "unsupported",
        "invalid_input"
      ],
      "description": "ready이면 모든 문항이 조항 또는 협의 사항 중 하나에 정확히 한 번 들어간다. 다른 상태는 두 배열이 비고 message가 있다."
    },
    "clauses": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PactClause"
      },
      "description": "승부처까지 거쳐 정해진 문항의 조항. 문항 순서대로 쓴다."
    },
    "discussion_items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/DiscussionItem"
      },
      "description": "승부처에서 직접 논의하기로 한 문항."
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "description": "ready가 아닐 때 이유를 알리는 짧은 설명."
    }
  },
  "required": [
    "status",
    "clauses",
    "discussion_items"
  ],
  "additionalProperties": false,
  "definitions": {
    "PactClause": {
      "type": "object",
      "properties": {
        "scenario_id": {
          "type": "string",
          "description": "조항의 근거 문항 ID."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "협약서체 조항 한두 문장. 여행 전체의 원칙으로 쓰며 실제 일정·숫자·이유·이름을 쓰지 않는다."
        }
      },
      "required": [
        "scenario_id",
        "text"
      ],
      "additionalProperties": false
    },
    "DiscussionItem": {
      "type": "object",
      "properties": {
        "scenario_id": {
          "type": "string",
          "description": "협의 사항의 근거 문항 ID."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "무엇이 갈렸는지 한 문장으로 쓰고 \"당사자 간 직접 논의하여 정한다.\"로 끝낸다."
        }
      },
      "required": [
        "scenario_id",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
