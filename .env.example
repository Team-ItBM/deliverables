# 서버 실행. .env는 자동으로 읽지 않는다: set -a; source .env; set +a
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/dowon_local
LLM_MODE=replay
PUBLIC_BASE_URL=http://localhost:8000
DB_INIT_ON_START=1
TRUSTED_PROXY_HOPS=0

# LLM_MODE=live일 때 필수
OPENAI_API_KEY=

# 푸시. 셋 다 넣어야 푸시가 동작한다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# 선택. 비워 두면 기본 경로를 쓴다
LLM_CONFIG=
LLM_REPLAY_FILE=
POOL_PATH=
WEB_DIST=

# 관리 명령(travel.server.admin). 버킷이 비면 기록을 S3에 쓰지 않는다
ADMIN_AUDIT_BUCKET=
ADMIN_AUDIT_PREFIX=admin-audit/
ADMIN_OPERATOR=

# 서버 계약 테스트
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres